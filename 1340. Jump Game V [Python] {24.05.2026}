class Solution:
    def maxJumps(self, arr: list[int], d: int) -> int:
        n = len(arr)
        dp = {}
        
        def dfs(i: int) -> int:
            if i in dp:
                return dp[i]
            
            res = 1
            
            for j in range(i + 1, min(i + d + 1, n)):
                if arr[j] >= arr[i]:
                    break
                res = max(res, 1 + dfs(j))
                
            for j in range(i - 1, max(i - d - 1, -1), -1):
                if arr[j] >= arr[i]:
                    break
                res = max(res, 1 + dfs(j))
                
            dp[i] = res
            return res
            
        return max(dfs(i) for i in range(n))
