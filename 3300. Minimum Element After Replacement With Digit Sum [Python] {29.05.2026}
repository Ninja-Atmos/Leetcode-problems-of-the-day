class Solution:
    def minElement(self, nums: list[int]) -> int:
        min_sum = float('inf')
        
        for num in nums:
            current_sum = 0
            temp = num            

            while temp > 0:
                current_sum += temp % 10
                temp //= 10
                
            if current_sum < min_sum:
                min_sum = current_sum
                
        return min_sum
